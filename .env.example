# Public token from Cloudflare > Web Analytics > Manage site > JavaScript snippet.
# This is the beacon site token, NOT a Cloudflare API token or an R2 credential.
NUXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=9a5621b4526f4a30b17d5cc38fe7786f

# Exact production hostnames separated by commas, without protocol or path.
# Production domain for this project.
NUXT_PUBLIC_CLOUDFLARE_ANALYTICS_HOSTS=nenes.ismaelsebbane.com

# Public Worker URL after running pnpm analytics:deploy; must end in /events.
NUXT_PUBLIC_CLOUDFLARE_ANALYTICS_EVENTS_ENDPOINT=https://nenes-analytics.hypersensibles.workers.dev/events

# Private, local-only token with Account Analytics Read permission for reports.
CLOUDFLARE_ACCOUNT_ID=a503ff7440f0bf13c7058d387d84661d
CLOUDFLARE_ANALYTICS_READ_TOKEN=
